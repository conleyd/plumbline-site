# Plumbline site configuration. These are the only two values to edit.
#
# CONTACT_EMAIL: the address every mailto link on the site points at.
CONTACT_EMAIL=conley.dylan@gmail.com
#
# BASE_URL: the public address of the site, no trailing slash.
# Leave it empty to use, in order:
#   1. https://<domain> if a CNAME file exists at the repository root, or
#   2. https://<owner>.github.io/<repo> when built by GitHub Actions.
# Set it only to override both.
BASE_URL=
